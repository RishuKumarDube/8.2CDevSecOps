pipeline {
    agent any
    
    environment {
        RECIPIENTS = 'rishukrdube@gmail.com'
    }
    
    tools {
        nodejs 'node18'
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/RishuKumarDube/8.2CDevSecOps.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'npm test || exit /b 0'
            }
        }

        stage('Generate Coverage Report') {
            steps {
                bat 'npm run coverage || exit /b 0'
            }
        }

        stage('NPM Audit (Security Scan)') {
            steps {
                bat 'npm audit || exit /b 0'
            }
        }
    }
    post {

        success {

            emailext(

                subject: "Jenkins Pipeline Success: ${env.JOB_NAME} #${env.BUILD_NUMBER}",

                body: "Pipeline executed successfully. Check console output: ${env.BUILD_URL}",

                to: "${env.RECIPIENTS}",

                attachLog: true

            )

        }

        failure {

            emailext(

                subject: "Jenkins Pipeline Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",

                body: "Pipeline failed. Check console output: ${env.BUILD_URL}",

                to: "${env.RECIPIENTS}",

                attachLog: true

            )

        }

    }
}